{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lint:workspace",
            "type": "npm",
            "script": "lint",
            "path": "",
            "group": "test",
            "problemMatcher": [
                {
                    "owner": "eslint",
                    "source": "eslint",
                    "fileLocation": ["absolute"],
                    "pattern": [
                        {
                            "regexp": "^(/.+)$",
                            "file": 1
                        },
                        {
                            "regexp": "^\\s+(\\d+):(\\d+)\\s+(error|warning)\\s+(.+?)\\s{2,}(@?[^\\s]+)$",
                            "line": 1,
                            "column": 2,
                            "severity": 3,
                            "message": 4,
                            "code": 5,
                            "loop": true
                        }
                    ]
                }
            ],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
