{
    "name": "cis-number-matcher-electron",
    "private": true,
    "version": "0.1.0",
    "description": "CI's Number Matcher desktop app",
    "type": "module",
    "main": "dist/electron/main.js",
    "scripts": {
        "build:packages": "./install.sh --dev",
        "build:electron": "tsc -p electron/tsconfig.json",
        "build": "npm run build:packages && npm run build:electron",
        "start": "npm run build && electron dist/electron/main.js",
        "package": "npm run package:linux",
        "package:linux": "npm run build && electron-builder --linux AppImage",
        "package:win": "npm run build && electron-builder --win nsis portable"
    },
    "devDependencies": {
        "electron": "^37.4.0",
        "electron-builder": "^26.0.12",
        "typescript": "^5.9.2"
    },
    "build": {
        "appId": "net.whg.numbermatcher",
        "productName": "CI Number Matcher",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/electron/**/*",
            "frontend/dist/**/*",
            "backend/dist/**/*",
            "backend/node_modules/**/*",
            "backend/package.json",
            "common/dist/**/*",
            "common/package.json"
        ],
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Game"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        }
    }
}
